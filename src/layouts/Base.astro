---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	/** The home page draws its own header inside the hero. */
	bareHeader?: boolean;
}
const { title, description, bareHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="theme-color" content="#161c1a" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preload" href="/fonts/bodoni-moda.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/jost.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		{
			!bareHeader && (
				<header class="bar">
					<a class="wordmark" href="/">Karthik Surkanti</a>
					<nav class="bar__links" aria-label="Site">
						<a href="/#work">Work</a>
						<a href="/run/">What I run</a>
						<a class="btn btn--small" href="https://book.karthiksurkanti.in/">Handbook</a>
					</nav>
				</header>
			)
		}
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script>
			// Parts of each section arrive once, in reading order. Content is visible
			// without JavaScript and under reduced motion (styles only hide it under html.js).
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const root = document.documentElement;
			if (reduce || !('IntersectionObserver' in window)) {
				root.classList.add('still');
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							e.target.classList.add('is-in');
							io.unobserve(e.target);
						}
					},
					{ rootMargin: '0px', threshold: 0 },
				);
				document.querySelectorAll('[data-reveal], .prose > *').forEach((el) => io.observe(el));
			}
			requestAnimationFrame(() => root.classList.add('loaded'));
		</script>
	</body>
</html>
